# ========================
# OnionGuard ML Microservice — Environment Variables
# ========================

PORT=8000

# AGMARKNET API Key
# Get free at: https://data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi
# Click "Get API Key" → Register → use key below
AGMARKNET_API_KEY=YOUR_AGMARKNET_API_KEY

# Set to "true" to always use mock data (ignores API key)
USE_MOCK_DATA=false

# Commodity code for onion on AGMARKNET
AGMARKNET_COMMODITY=Onion
